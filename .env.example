# Control plane
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
SECRET_KEY=change-me-to-a-long-random-string
MASTER_KEY=change-me-32-byte-key-for-aesgcm!!!!

# MongoDB (local default). Production: Atlas / self-hosted URI.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=finehelper

# Web (apps/web)
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Gemini for Trust Score explanations + Trust Agent chat polish (optional).
# Without this key, agent uses template replies in English/Hinglish.
# GEMINI_API_KEY=

# Sarvam AI — voice shell STT (Saaras) + TTS (Bulbul). Keeps brain = /v1/agent/chat.
# SARVAM_API_KEY=
# SARVAM_TTS_SPEAKER=anushka

# Trust model artifact path (default relative to repo root)
# TRUST_MODEL_PATH=apps/api/finehelper_api/ml/artifacts/trust_model.joblib

# Blockchain attestation — local hash-linked ledger is ALWAYS used.
# Optional Polygon (Amoy) / any EVM: install web3 (`pip install 'finehelper-core[chain]'`)
# and deploy contracts/TrustAttestation.sol, then set:
# CHAIN_RPC_URL=https://rpc-amoy.polygon.technology
# CHAIN_PRIVATE_KEY=
# CHAIN_CONTRACT_ADDRESS=
# CHAIN_ID=80002
# CHAIN_NETWORK=polygon-amoy
# CHAIN_EXPLORER_URL=https://amoy.polygonscan.com

# Optional Redis
# REDIS_URL=redis://localhost:6379/0

# Object storage — leave empty to use local .data/storage (dev only).
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=finehelper
# S3_REGION=auto

FH_EMBEDDED_WORKER=1

# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
# HF_TOKEN=
