# Control plane
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
SECRET_KEY=change-me-to-a-long-random-string
MASTER_KEY=change-me-32-byte-key-for-aesgcm!!!!

# Database — Postgres in production (Render/Supabase). SQLite works locally.
DATABASE_URL=sqlite+aiosqlite:///./.data/finehelper.db
# DATABASE_URL=postgresql+asyncpg://finehelper:finehelper@localhost:5432/finehelper

# Optional Redis (Render Key Value). Jobs still run via Postgres SKIP LOCKED without it.
# REDIS_URL=redis://localhost:6379/0

# Object storage — leave empty to use local .data/storage (dev only).
# S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=finehelper
# S3_REGION=auto

# Embedded CPU worker inside the API process (convenient for local dev)
FH_EMBEDDED_WORKER=1

# Modal (LoRA GPU). Only needed for backend: lora_modal
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# Hugging Face token for gated base models
# HF_TOKEN=
